{{- /*
Cloudflare _redirects: /id/<uuid> → current URL (303), then slash canonicalization.
Drafts are omitted (not in RegularPages).
*/ -}}
# Generated by layouts/home.redirects — do not edit by hand.

# Material Identity URI → current location. 303, because an identifier and its
# representation are different resources.
{{ range where site.RegularPages "Section" "library" -}}
{{ $material := . -}}
{{ with .Params.id -}}
/id/{{ . }} {{ partial "canonical-url.html" $material.RelPermalink }} 303
{{ end -}}
{{ end }}
# Library catalog compatibility: both forms go directly to the canonical catalog.
/library/all /library 301
/library/all/ /library 301

# Trailing-slash → canonical (permanent; html_handling alone is temporary 307).
/*/ /:splat 301
