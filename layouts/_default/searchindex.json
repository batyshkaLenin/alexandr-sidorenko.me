{{- /*
/search-index.json for <dc-command-palette>. Canonical URLs; bodies via .Plain
(redactions stay absent). `path` matches the top-bar shape; `kind` is machine-facing.
*/ -}}
{{- $entries := slice -}}

{{- /* Materials: full body text, not only summary. */ -}}
{{- range (where site.RegularPages "Section" "library").ByDate.Reverse -}}
  {{- $entries = $entries | append (dict
    "title" .Title
    "url" (partial "canonical-url.html" .RelPermalink)
    "path" (partial "search/path.html" .RelPermalink)
    "type" (partial "publication/type-label.html" (dict "type" .Params.type "page" .))
    "kind" (cond (eq (index hugo.Data.creative_types .Params.type).family "audio") "audio" "text")
    "topics" (default (slice) .Params.tags)
    "summary" (partial "publication/summary.txt" .)
    "text" (partial "search/plain.html" .)
  ) -}}
{{- end -}}

{{- /* The ways to browse are findable too: a visitor who types "таблица" or
"library/types" is looking for a page, not a material. */ -}}
{{- range where site.RegularPages "Params.view" "!=" nil -}}
  {{- $entries = $entries | append (dict
    "title" .Title
    "url" (partial "canonical-url.html" .RelPermalink)
    "path" (partial "search/path.html" .RelPermalink)
    "type" (i18n "searchKindView")
    "kind" "view"
    "topics" (slice)
    "summary" .Description
    "text" ""
  ) -}}
{{- end -}}

{{- /* Topics index is browseable like the other library views. */ -}}
{{- with site.GetPage "/tags" -}}
  {{- $entries = $entries | append (dict
    "title" .Title
    "url" (partial "canonical-url.html" .RelPermalink)
    "path" (partial "search/path.html" .RelPermalink)
    "type" (i18n "searchKindView")
    "kind" "view"
    "topics" (slice)
    "summary" .Description
    "text" ""
  ) -}}
{{- end -}}

{{- /* Type pages are searchable addresses. */ -}}
{{- range where site.RegularPages "Params.material_type" "!=" nil -}}
  {{- $entries = $entries | append (dict
    "title" .Title
    "url" (partial "canonical-url.html" .RelPermalink)
    "path" (partial "search/path.html" .RelPermalink)
    "type" (i18n "searchKindType")
    "kind" "type"
    "topics" (slice)
    "summary" .Description
    "text" ""
  ) -}}
{{- end -}}

{{- with site.GetPage "/library" -}}
  {{- $entries = $entries | append (dict
    "title" .Title
    "url" (partial "canonical-url.html" .RelPermalink)
    "path" (partial "search/path.html" .RelPermalink)
    "type" (i18n "searchKindSection")
    "kind" "section"
    "topics" (slice)
    "summary" .Description
    "text" ""
  ) -}}
{{- end -}}

{{- range site.Taxonomies.tags -}}
  {{- with .Page -}}
    {{- $entries = $entries | append (dict
      "title" .Title
      "url" (partial "canonical-url.html" .RelPermalink)
      "path" (partial "search/path.html" .RelPermalink)
      "type" (i18n "searchKindTopic")
      "kind" "topic"
      "topics" (slice .Title)
      "summary" .Description
      "text" ""
    ) -}}
  {{- end -}}
{{- end -}}

{{- /* No build timestamp: the file changes when the site's content changes and
not once per build, so a cached copy stays valid as long as it is true. */ -}}
{{- dict "entries" $entries | jsonify -}}
