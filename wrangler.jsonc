{
  // Cloudflare Workers project name (becomes <name>.<subdomain>.workers.dev for preview)
  "name": "alexandr-sidorenko-me",
  "compatibility_date": "2026-08-06",
  "build": {
    "command": "chmod a+x build.sh && ./build.sh"
  },
  // Phase B (T31 / T1): enable commit/version preview evidence only when
  // Cloudflare Git integration is activated. Do not set preview_urls here
  // before that — manual wrangler previews stay ad-hoc until T1.
  // "preview_urls": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    // Canonical URLs carry no trailing slash.
    // The platform default is the opposite — auto-trailing-slash, which answered
    // /creativity with a 307 to /creativity/ and made every canonical link a
    // redirect.
    "html_handling": "drop-trailing-slash"
  }
}
