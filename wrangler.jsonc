{
  // Cloudflare Workers project name (becomes <name>.<subdomain>.workers.dev for preview)
  "name": "alexandr-sidorenko-me",
  "compatibility_date": "2026-08-06",
  // T1: PR / Workers Builds entry — build.sh (T29) then validate.sh (T30).
  // Dashboard build_command should stay empty so this repo file is the only
  // source of truth; non-production deploy must remain `wrangler versions upload`.
  "build": {
    "command": "chmod a+x scripts/ci.sh && ./scripts/ci.sh"
  },
  // Commit/version preview URLs for Workers Builds evidence on PRs.
  "preview_urls": true,
  // Workers Logs in the repo so dashboard-only settings cannot drift on deploy.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    // Canonical URLs carry no trailing slash.
    // The platform default is the opposite — auto-trailing-slash, which answered
    // /creativity with a 307 to /creativity/ and made every canonical link a
    // redirect.
    "html_handling": "drop-trailing-slash"
  }
}
