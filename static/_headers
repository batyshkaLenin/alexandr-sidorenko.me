# Header contract for Workers Static Assets (T72).
# Values come from .ai/adr/redesign-headers-and-cache-contract.md — this file
# implements that decision and does not make its own.
#
# Cloudflare applies *every* matching rule and joins repeated header names with
# a comma, so Cache-Control is never set on /* — a page would end up with two
# joined policies. HTML therefore keeps the platform default
# (public, max-age=0, must-revalidate), which is exactly what the contract asks
# for, and only the classes that need something else are listed below.
#
# immutable appears only on content-addressed URLs, where changing the bytes
# changes the URL. Fonts and audio live at stable addresses, so they get a week
# with revalidation instead of a year without it.

# connect-src carries one external host: the activity pane's dev module refreshes
# the shape of the week from the public Code::Stats endpoint when JavaScript is
# available (ADR redesign-activity-dev-module). Nothing else on the page fetches
# anything from anywhere.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self'; connect-src 'self' https://codestats.net; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()

# Content-addressed: the hash is in the file name.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/avatar_hu_*
  Cache-Control: public, max-age=31536000, immutable

# The dithered portrait carries the digest of the photograph it came from, so
# replacing the photograph replaces the address (T129).
/avatar.dither-*
  Cache-Control: public, max-age=31536000, immutable

/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable

/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/assets/*.png
  Cache-Control: public, max-age=31536000, immutable

# Stable addresses: a week, revalidated.
/fonts/*
  Cache-Control: public, max-age=604800

/assets/*.mp3
  Cache-Control: public, max-age=604800

# Icons and manifest change rarely but keep their addresses.
/favicon.ico
  Cache-Control: public, max-age=86400

/logo192.png
  Cache-Control: public, max-age=86400

/logo512.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

# Feeds and machine-readable maps: fresh enough for a reader's client to notice
# a new publication the same day.
#
# Content-Type is set here because the platform derives it from the file
# extension and lands on application/xml and application/json — the generic
# types, not the feed ones Hugo declares. A feed reader is entitled to the
# specific type (T4). Setting the header replaces the platform's value; no
# removal line is needed, and repeated names are only joined between separate
# matching rules.
/feed.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/rss+xml; charset=utf-8

/feed.json
  Cache-Control: public, max-age=3600
  Content-Type: application/feed+json; charset=utf-8

/library/feed.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/rss+xml; charset=utf-8

/library/feed.json
  Cache-Control: public, max-age=3600
  Content-Type: application/feed+json; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

# The search index lives at a stable address and follows the materials, so it
# revalidates on the same hour as the feeds rather than claiming immutability
# it cannot have (T134).
/search-index.json
  Cache-Control: public, max-age=3600

# The cleanup worker unregisters stale service workers, so a visitor must not
# be stuck with a cached copy of it (T38, T59).
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
